# Скопируйте в .env.local для локальной разработки. На Vercel эти же переменные задаются
# в Settings -> Environment Variables (BLOB_READ_WRITE_TOKEN появляется сам при подключении Blob).

# Пароль админки /admin (минимум 6 символов)
ADMIN_PASSWORD=

# Заказы в Telegram: токен бота от @BotFather и id чата персонала (для групп начинается с -100)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Необязательно: id темы, если чат с темами (форум)
# TELEGRAM_THREAD_ID=
# Необязательно: часовой пояс времени в сообщении, по умолчанию Europe/Moscow
# ORDER_TIMEZONE=Europe/Moscow

# Vercel Blob (хранилище меню и фото). Локально можно не задавать:
# тогда меню пишется в .data/menu.json, фото в .data/uploads/
# BLOB_READ_WRITE_TOKEN=
